{
  "name": "seven-boom-capacitor",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iOS apps wrapping the 7-Boom docs web client",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "build:android": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "esbuild": "^0.28.2"
  }
}
